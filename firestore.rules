rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // Proposed account boundary, exercised locally. Not deployed to a live project.
    match /users/{uid}/profile/info {
      allow read, delete: if owns(uid);
      allow create, update: if owns(uid) && request.resource.data.uid == uid;
    }
    match /users/{uid}/config/mosque {
      allow read, write: if owns(uid);
    }
    match /users/{uid}/prayerCache/{month} {
      allow read, write: if owns(uid) && month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }
    // All other paths are denied, including sibling configuration documents.
  }
}
