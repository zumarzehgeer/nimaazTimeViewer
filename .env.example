# Firebase WEB APP configuration for a separate development project.
# These values are included in the browser bundle. Never use Admin/service-account credentials.
VITE_FIREBASE_API_KEY=replace-with-development-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-development-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-development-project
VITE_FIREBASE_STORAGE_BUCKET=your-development-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-messaging-sender-id
VITE_FIREBASE_APP_ID=replace-with-web-app-id
