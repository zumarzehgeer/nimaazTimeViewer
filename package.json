{
  "name": "nimaaz-time-viewer",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --test tests-unit/*.test.mts",
    "test:e2e": "node scripts/build-browser-test.mjs && playwright test",
    "test:emulators": "npx --yes firebase-tools@15.36.0 emulators:exec --project demo-nimaaz --config firebase.emulators.json --only auth,firestore \"node scripts/run-account-tests.mjs\""
  },
  "dependencies": {
    "@tabler/icons-react": "^3.41.1",
    "date-fns": "^3.6.0",
    "firebase": "^12.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.56.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.5.3",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^1.2.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.7"
    },
    "workbox-build": {
      "glob": "14.0.6"
    }
  }
}
